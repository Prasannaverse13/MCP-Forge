# Nebius Token Factory key (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=
# Tavily key (https://tavily.com)
TAVILY_API_KEY=

# Optional. Leave empty to auto-pick Nemotron models from the Token Factory list.
NEBIUS_WRITER_MODEL=
NEBIUS_FIXER_MODEL=

# local = run tests on this machine (dev only). nebius = Serverless Job + Serverless Endpoint.
FORGE_RUNNER=local

# Only for FORGE_RUNNER=nebius. Needs the nebius CLI installed and logged in.
NEBIUS_PROJECT_ID=
NEBIUS_JOB_PLATFORM=
NEBIUS_JOB_PRESET=
